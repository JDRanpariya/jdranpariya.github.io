---
permalink: /sitemap/
eleventyExcludeFromCollections: true
layout: layouts/base.njk
title: Sitemap
description: All discoverable pages on this site, listed for search engines.
---

{% from "components/post-index.njk" import indexHeader, postRow %}

<section class="post-index space-y-16 md:space-y-20">
    {{ indexHeader(title, "Every discoverable page on this site. Listed here so search engines can find everything.") }}

    {%- macro sectionHeading(icon, label, id) %}
      <h2{% if id %} id="{{ id }}"{% endif %} class="font-heading text-h3 text-ink mb-2">{{ icon }} {{ label }}</h2>
    {%- endmacro %}

    {# Home / top-level pages #}
    {%- set found = false %}
    {%- for item in collections.all %}
      {%- set d = item.data %}
      {%- if item.url and item.url != false and d.status != "draft" and d.sitemap != false and not item.url.startsWith("/404") and not item.url.startsWith("/now/updates/") and not item.url.startsWith("/sitemap/") and not item.url.startsWith("/writings/") and not item.url.startsWith("/notes/") and not item.url.startsWith("/library/") and not item.url.startsWith("/projects/") and not item.url.startsWith("/odysseys/") and not item.url.startsWith("/tags/") %}
        {%- if not found %}
          {%- set found = true %}
          <section aria-labelledby="section-pages">
          {{ sectionHeading("⌂", "Pages", "section-pages") }}
          <ol class="post-list">
        {%- endif %}
        {{ postRow(item, d.published, 3) }}
      {%- endif %}
    {%- endfor %}
    {%- if found %}</ol></section>{%- endif %}

    {# Writings #}
    {%- set found = false %}
    {%- for item in collections.all %}
      {%- set d = item.data %}
      {%- if item.url and item.url != false and d.status != "draft" and d.sitemap != false and item.url.startsWith("/writings/") %}
        {%- if not found %}
          {%- set found = true %}
          <section aria-labelledby="section-writings">
          {{ sectionHeading("✎", "Writings", "section-writings") }}
          <ol class="post-list">
        {%- endif %}
        {{ postRow(item, d.published, 3) }}
      {%- endif %}
    {%- endfor %}
    {%- if found %}</ol></section>{%- endif %}

