---
title: Writings
description: "Essays on whatever I'm thinking through, usually somewhere between science and life."
layout: layouts/base
section: "writings index"
---

<section class="max-w-content mx-auto px-6 py-12 md:py-20">
  <header class="mb-12 space-y-3">
    <h1 class="font-heading text-h2 text-ink">Writings</h1>
    <p class="max-w-xl text-body-sm text-ink-secondary">
      Essays on whatever I'm thinking through, usually somewhere between science and life.
    </p>
  </header>

  <ol class="m-0 list-none space-y-3 p-0">
    {% for post in collections.writings | sort(true, false, "data.published") %}
      <li>
        <a
          href="{{ post.url }}"
          class="group grid grid-cols-[4.75rem_1fr] items-baseline gap-2 py-1"
        >
          <time
            datetime="{{ post.data.published | isoDate }}"
            class="font-sans text-ui-sm tabular-nums text-ink-muted"
          >
            {{ post.data.published | dateToFormat("yyyy · MM") }}
          </time>
          <h2
            class="m-0 font-serif text-body-sm font-normal text-ink transition-colors duration-base group-hover:text-accent"
          >
            {{ post.data.title | smartTitleCase }}
          </h2>
        </a>
      </li>
    {% endfor %}
  </ol>
</section>
