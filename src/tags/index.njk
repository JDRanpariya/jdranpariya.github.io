---
title: "All Tags"
layout: layouts/base
section: "tags index"
permalink: /tags/
---

{% from "components/post-index.njk" import indexHeader, postList %}

<section class="post-index">
  {{ indexHeader(title) }}

  <ul class="chip-list leading-loose">
    {% for tag in collections.tagListMulti %}
      {% set itemCount = ((collections.writings or []) | filterByTag(tag) | length) + ((collections.lectures or []) | filterByTag(tag) | length) + ((collections.odysseys or []) | filterByTag(tag) | length) + ((collections.books or []) | filterByTag(tag) | length) + ((collections.projects or []) | filterByTag(tag) | length) + ((collections.papers or []) | filterByTag(tag) | length) + ((collections.notes or []) | filterByTag(tag) | length) %}
      <li>
        <a href="/tags/{{ tag | slugify }}/" class="chip">
          {{ tag }} <span class="text-ink-muted">({{ itemCount }})</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
