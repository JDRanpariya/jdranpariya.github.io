{# One resolved description drives search, social previews, and structured data. #}
<title>
  {% if section == "home" %}
    {{ site.name }}
  {% elif title %}
    {{ title | smartTitleCase }}
    | {{ site.name }}
  {% else %}
    {{ site.name }}
  {% endif %}
</title>
<meta name="description" content="{{ metadata.description }}" />
{% if noindex %}
  <meta name="robots" content="noindex" />
{% else %}
  <link rel="canonical" href="{{ metadata.url }}" />
{% endif %}
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml" />
<link rel="webmention" href="https://webmention.io/jdranpariya.com/webmention" />
<link rel="pingback" href="https://webmention.io/jdranpariya.com/xmlrpc" />
{{ metadata.structuredData | jsonLdScript | safe }}
<meta property="og:type" content="{{ metadata.type }}" />
<meta property="og:title" content="{{ metadata.title | smartTitleCase }}" />
<meta property="og:description" content="{{ metadata.description }}" />
<meta property="og:url" content="{{ metadata.url }}" />
<meta property="og:site_name" content="{{ metadata.siteName }}" />
<meta property="og:image" content="{{ metadata.image }}" />
<meta property="og:image:width" content="{{ site.image.width }}" />
<meta property="og:image:height" content="{{ site.image.height }}" />
<meta property="og:image:alt" content="{{ metadata.imageAlt }}" />
{% if published %}
  <meta property="article:published_time" content="{{ published | isoDateTime }}" />
{% endif %}
{% if lastUpdated %}
  <meta property="article:modified_time" content="{{ lastUpdated | isoDateTime }}" />
{% endif %}
{% for tag in tags %}<meta property="article:tag" content="{{ tag }}" />{% endfor %}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ metadata.title | smartTitleCase }}" />
<meta name="twitter:description" content="{{ metadata.description }}" />
<meta name="twitter:image" content="{{ metadata.image }}" />
<meta name="twitter:image:alt" content="{{ metadata.imageAlt }}" />
<meta name="twitter:site" content="{{ site.socialHandle }}" />
<meta name="twitter:creator" content="{{ site.socialHandle }}" />
