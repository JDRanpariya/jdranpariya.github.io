---
layout: layouts/base.njk
---

{% from "components/post-index.njk" import indexHeader, postList %}

<section class="post-index">
  {{ indexHeader(title, description if description != title else "") }}
  {% if content %}<div class="prose-site mb-16">{{ content | safe }}</div>{% endif %}
  {% set children = collections.all | folderChildren(page.inputPath) %}
  {% if children.length %}
    <nav aria-label="Pages in this folder">{{ postList(children) }}</nav>
  {% endif %}
</section>
