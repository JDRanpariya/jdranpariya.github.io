  <!-- Self-hosted fonts (Fraunces + Literata) loaded via @font-face in CSS.
       Only normal-weight variants are preloaded (used above the fold).
       Italic variants load on demand via font-display:swap — avoids ~97 KB
       of eagerly-fetched bytes that are rarely needed on first paint. -->
  <link rel="preload" href="/assets/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/literata-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <!-- Umami analytics (preconnect only; script is injected conditionally below) -->
  <link rel="preconnect" href="https://jay-cloud.vercel.app">

  <!-- Tailwind CSS -->
  <link rel="stylesheet" href="/css/style.css{{ '/css/style.css' | cacheBust }}" />

{% if isPostLayout %}
{# Self-hosted (previously CDN-loaded from jsdelivr/unpkg — see git history
   for the version-pinned CDN URLs + SRI digests if reverting).
   KaTeX is only loaded when hasMath is true (set in frontmatter).
   Prism is only loaded when hasCode is true (set in frontmatter).
   This avoids ~30 KB of CSS on posts that don't use math or code. #}
{% if hasMath %}
<link rel="stylesheet" href="/assets/vendor/katex/katex.min.css" />
{% endif %}
{% if hasCode %}
<link rel="stylesheet" href="/assets/vendor/prism/prism-gruvbox-dark.css" />
{% endif %}
{% endif %}

  <!-- Theme initialization to prevent flash.
       localStorage access is wrapped in try/catch because private-browsing
       Safari and storage-disabled contexts throw SecurityError on read;
       without the guard the whole IIFE would crash before <body> renders. -->
  <script>
  (function() {
    let savedTheme = null;
    try { savedTheme = localStorage.getItem('theme'); } catch (e) {}
    const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
      document.documentElement.classList.add('dark');
    }
  })();
  </script>
  </head>

  <body class="bg-bg text-ink min-h-screen flex flex-col antialiased"
      data-title="{{ title | safe }}"
      data-section="{{ section | default('general') }}"
      data-tags="{{ tags | default([]) | join(',') }}"
      data-series="{{ series | default('') }}">

  <!-- Keyboard-only: jump past the nav straight to page content. -->
  <a href="#main" class="skip-to-content">Skip to content</a>

  <!-- Navigation -->
  {% include "components/nav.njk" %}

  <!-- Main Content -->
  <main id="main" class="flex-grow" tabindex="-1">
  {{ content | safe }}
  </main>

  <!-- Footer -->
  {% include "components/footer.njk" %}

  <!-- Site scripts (theme toggle, mobile menu, delegated clicks). -->
  <script src="/assets/js/site.js" defer></script>
  {% if hasInteractive %}
  <script type="module" src="/interactive/loader.js"></script>
  {% endif %}

  </body>
  </html>
