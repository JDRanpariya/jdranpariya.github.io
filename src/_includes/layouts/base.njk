<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="google-site-verification" content="XOxpJ5TAXaHPR2dTFAIRVZ1e5m-yhGDtDeeehwiVhhs" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
{#
  Content Security Policy.
  Note: 'unsafe-inline' is required for scripts (theme init, Umami injector, mobile menu)
  and for Tailwind @apply / prose styles in prod. Refactoring to external JS + hashes is
  tracked as tech debt.
  Origins:
    - self: own site
    - jay-cloud.vercel.app: Umami analytics
    - fonts.googleapis.com, fonts.gstatic.com: (removed — fonts self-hosted now)
    - cdn.jsdelivr.net (script-src/connect-src only): interactive/ modules
      dynamically import mermaid, d3, matter-js, scrollama, model-viewer.
      KaTeX + Prism CSS are self-hosted now (assets/vendor/), so jsdelivr and
      unpkg are no longer needed in style-src/font-src.
    - img-src allows webmention.io for avatar images in webmentions.
      All content images are processed at build time via eleventy-img.
#}
<meta
  http-equiv="Content-Security-Policy"
  content="
    default-src 'self';
    script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://jay-cloud.vercel.app https://cdn.jsdelivr.net https://cdn.plot.ly https://esm.sh;
    style-src 'self' 'unsafe-inline';
    font-src 'self';
    img-src 'self' data: https://webmention.io;
    connect-src 'self' https://jay-cloud.vercel.app https://cdn.jsdelivr.net https://cdn.plot.ly https://esm.sh;
    worker-src 'self' blob:;
    frame-src 'self' https://docs.google.com https://cad.onshape.com;
    base-uri 'self';
    form-action 'self' https://docs.google.com;
    object-src 'none';
    upgrade-insecure-requests
  "
/>

<script>
  if (
    !location.hostname.includes("localhost") &&
    !location.hostname.includes("127.0.0.1")
  ) {
    const s = document.createElement("script");
    s.defer = true;
    s.src = "https://jay-cloud.vercel.app/script.js";
    s.dataset.websiteId = "a210a5bb-3c45-4542-be4e-d3b7efa3de33";
    document.head.appendChild(s);
  }
</script>

