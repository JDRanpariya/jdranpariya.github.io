<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="google-site-verification" content="XOxpJ5TAXaHPR2dTFAIRVZ1e5m-yhGDtDeeehwiVhhs" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
{#
  Content Security Policy.
  Note: 'unsafe-inline' is required for scripts (Umami injector and JSON-LD)
  and for Tailwind @apply / prose styles in prod. Refactoring to external JS + hashes is
  tracked as tech debt.
  Origins:
    - self: own site
    - jay-cloud.vercel.app: Umami analytics
    - fonts.googleapis.com, fonts.gstatic.com: (removed — fonts self-hosted now)
    - cdn.jsdelivr.net (script-src/connect-src only): interactive/ modules
      dynamically import mermaid, d3, matter-js, scrollama, model-viewer.
      KaTeX + Prism CSS are self-hosted now (assets/vendor/), so jsdelivr and
      unpkg are no longer needed in style-src/font-src.
    - img-src allows webmention.io for avatar images in webmentions.
      All content images are processed at build time via eleventy-img.
#}
<meta
  http-equiv="Content-Security-Policy"
  content="
    default-src 'self';
    script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://jay-cloud.vercel.app https://cdn.jsdelivr.net https://cdn.plot.ly https://esm.sh;
    style-src 'self' 'unsafe-inline';
    font-src 'self';
    img-src 'self' data: https://webmention.io;
    connect-src 'self' https://jay-cloud.vercel.app https://cdn.jsdelivr.net https://cdn.plot.ly https://esm.sh;
    worker-src 'self' blob:;
    frame-src 'self' https://docs.google.com https://cad.onshape.com;
    base-uri 'self';
    form-action 'self' https://docs.google.com https://buttondown.com;
    object-src 'none';
    upgrade-insecure-requests
  "
/>

<script>
  (function () {
    const isLocal =
      location.hostname.includes("localhost") ||
      location.hostname.includes("127.0.0.1");
    let analyticsDisabled = false;

    try {
      const params = new URLSearchParams(location.search);
      const preference = params.get("analytics");

      if (preference === "off") {
        localStorage.setItem("umami.disabled", "1");
      } else if (preference === "on") {
        localStorage.removeItem("umami.disabled");
      }

      analyticsDisabled = localStorage.getItem("umami.disabled") === "1";

      if (preference === "off" || preference === "on") {
        params.delete("analytics");
        const query = params.toString();
        history.replaceState(
          null,
          "",
          location.pathname + (query ? "?" + query : "") + location.hash
        );
      }
    } catch (e) {}

    if (isLocal || analyticsDisabled) return;

    const s = document.createElement("script");
    s.defer = true;
    s.src = "https://jay-cloud.vercel.app/script.js";
    s.dataset.websiteId = "a210a5bb-3c45-4542-be4e-d3b7efa3de33";
    s.dataset.excludeHash = "true";
    document.head.appendChild(s);
  })();
</script>

{% include "components/metadata-head.njk" %}

  <!-- Favicon --->
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/logo/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/logo/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/logo/favicon-16x16.png">
<link rel="manifest" href="/assets/logo/site.webmanifest">

  <!-- Self-hosted fonts (Figtree + Source Serif 4) loaded via @font-face in CSS.
       Only normal-weight variants are preloaded (used above the fold).
       Italic variants load on demand via font-display:swap — avoids ~97 KB
       of eagerly-fetched bytes that are rarely needed on first paint. -->
  <link rel="preload" href="/assets/fonts/figtree-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/source-serif-4-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <!-- Umami analytics (preconnect only; script is injected conditionally below) -->
  <link rel="preconnect" href="https://jay-cloud.vercel.app">

  <!-- Tailwind CSS -->
  <link rel="stylesheet" href="/css/style.css{{ '/css/style.css' | cacheBust }}" />

{% if isPostLayout %}
{# Self-hosted (previously CDN-loaded from jsdelivr/unpkg — see git history
   for the version-pinned CDN URLs + SRI digests if reverting).
   KaTeX is only loaded when hasMath is true (set in frontmatter).
   Prism is only loaded when hasCode is true (set in frontmatter).
   This avoids ~30 KB of CSS on posts that don't use math or code. #}
{% if hasMath %}
<link rel="stylesheet" href="/assets/vendor/katex/katex.min.css" />
{% endif %}
{% if hasCode %}
<link rel="stylesheet" href="/assets/css/prism-light.css" />
{% endif %}
{% endif %}

  </head>

  <body class="bg-bg text-ink min-h-screen flex flex-col antialiased"
      data-title="{{ title | escape }}"
      data-section="{{ section | default('general') }}"
      data-tags="{{ tags | default([]) | join(',') }}"
      data-series="{{ series | default('') }}">

  <!-- Keyboard-only: jump past the nav straight to page content. -->
  <a href="#main" class="skip-to-content">Skip to content</a>

  <!-- Navigation -->
  {% include "components/nav.njk" %}

  <!-- Main Content -->
  <main id="main" class="flex-grow" tabindex="-1">
  {{ content | safe }}
  </main>

  <!-- Footer -->
  {% include "components/footer.njk" %}

  <!-- Site scripts (mobile menu, delegated clicks). -->
  <script src="/assets/js/site.js{{ '/assets/js/site.js' | cacheBust }}" defer></script>
  {% if hasInteractive %}
  <script type="module" src="/interactive/loader.js"></script>
  {% endif %}

  </body>
  </html>
