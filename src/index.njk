---
layout: layouts/base.njk
title: "Jay Ranpariya"
description: "I'm trying to understand intelligence from molecules to minds, and writing about what becomes possible when disciplines collide."
section: "home"
---

<section class="max-w-content mx-auto space-y-16 px-6 py-12 md:py-20">
  <!-- Opening -->
  <header class="space-y-4">
    <h1 class="font-heading text-h1 text-ink">Jay Ranpariya</h1>
    <p class="max-w-2xl text-body-sm text-ink-secondary md:text-body">
      I'm trying to build an understanding of intelligence from molecules to minds. Yeah, I know
      it's insane.
    </p>
  </header>

  <!-- Favorite writing -->
  <section aria-labelledby="home-writings" class="space-y-4">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="home-writings" class="eyebrow">Favorite writings</h2>
      <a
        href="/writings/"
        class="font-sans text-ui-sm text-ink-muted hover:text-accent transition-colors duration-base block py-2"
      >
        All writings →
      </a>
    </div>

    <ol class="m-0 list-none space-y-3 p-0">
      {% for post in collections.favoriteWritings %}
        <li>
          <a
            href="{{ post.url }}"
            class="group grid grid-cols-[4.75rem_1fr] items-baseline gap-2 py-1"
          >
            <time
              datetime="{{ post.data.published | isoDate }}"
              class="font-sans text-ui-sm tabular-nums text-ink-muted"
            >
              {{ post.data.published | dateToFormat("yyyy · MM") }}
            </time>
            <span
              class="text-body-sm text-ink transition-colors duration-base group-hover:text-accent"
            >
              {{ post.data.title | smartTitleCase }}
            </span>
          </a>
        </li>
      {% endfor %}
    </ol>
  </section>

  <!-- Writing topics -->
  <section aria-labelledby="home-topics" class="space-y-3">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="home-topics" class="eyebrow">Topics</h2>
      <a
        href="/tags/"
        class="block py-2 font-sans text-ui-sm text-ink-muted transition-colors duration-base hover:text-accent"
      >
        All tags →
      </a>
    </div>
    <ul class="m-0 flex list-none flex-wrap gap-x-2 gap-y-1 p-0 text-body-sm">
      {% for topic in collections.writingTopics %}
        <li>
          <a
            href="/tags/{{ topic | slugify }}/"
            class="text-ink underline decoration-border decoration-[1.5px] underline-offset-4 transition-colors duration-base hover:text-accent hover:decoration-accent"
            >{{ topic }}</a
          >{% if not loop.last %}<span class="text-ink-muted" aria-hidden="true">,</span>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </section>

  <!-- Follow -->
  <section aria-labelledby="home-follow" class="space-y-3">
    <h2 id="home-follow" class="eyebrow">Follow</h2>
    <p class="max-w-xl text-body-sm text-ink-secondary">
      Follow new writing through
      <a
        href="/feed.xml"
        class="underline decoration-border decoration-[1.5px] underline-offset-4 transition-colors duration-base hover:text-accent hover:decoration-accent"
        data-umami-event="rss-click"
        data-umami-event-location="home"
        >RSS</a
      >, or find me on
      <a
        href="https://x.com/jdranpariya"
        class="underline decoration-border decoration-[1.5px] underline-offset-4 transition-colors duration-base hover:text-accent hover:decoration-accent"
        >X</a
      >,
      <a
        href="https://github.com/jdranpariya"
        class="underline decoration-border decoration-[1.5px] underline-offset-4 transition-colors duration-base hover:text-accent hover:decoration-accent"
        >GitHub</a
      >, and
      <a
        href="https://linkedin.com/in/jdranpariya"
        class="underline decoration-border decoration-[1.5px] underline-offset-4 transition-colors duration-base hover:text-accent hover:decoration-accent"
        >LinkedIn</a
      >.
    </p>
  </section>
</section>
