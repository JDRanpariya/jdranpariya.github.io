---
permalink: /admin/index.html
eleventyExcludeFromCollections: true
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; connect-src 'self'; font-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'self'; object-src 'none'"
    />
    <title>Site admin</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/logo/favicon-32x32.png" />
    <link
      rel="preload"
      href="/assets/fonts/figtree-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/source-serif-4-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/css/style.css{{ '/css/style.css' | cacheBust }}" />
    <link rel="stylesheet" href="/assets/css/admin.css{{ '/assets/css/admin.css' | cacheBust }}" />
  </head>
  <body>
    <a class="admin-skip" href="#admin-main">Skip to main content</a>

    <header class="admin-topbar">
      <a class="admin-wordmark" href="/admin/" aria-label="Site admin home"
        >Jay's sites <span>/ admin</span></a
      >
      <div class="admin-account" id="admin-account" hidden>
        <nav class="admin-layout-controls" aria-label="Workspace layout">
          <button
            class="admin-text-button"
            type="button"
            data-panel-toggle="files"
            aria-pressed="true"
          >
            Files
          </button>
          <button
            class="admin-text-button"
            type="button"
            data-panel-toggle="edit"
            aria-pressed="true"
          >
            Editor
          </button>
          <button
            class="admin-text-button"
            type="button"
            data-panel-toggle="preview"
            aria-pressed="true"
          >
            Preview
          </button>
          <button class="admin-text-button" id="admin-reset-layout" type="button">
            Reset layout
          </button>
        </nav>
        <span id="admin-identity"></span>
        <button class="admin-text-button" id="admin-logout" type="button">Sign out</button>
      </div>
    </header>

    <main id="admin-main">
      <section class="admin-gate" id="admin-loading" aria-live="polite">
        <p>Checking sign-in…</p>
      </section>

      <section class="admin-gate" id="admin-login" hidden>
        <h1>Sign in</h1>
        <form class="admin-login-form" id="admin-login-form">
          <label for="admin-password">Passphrase</label>
          <input
            id="admin-password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
          <button class="admin-primary-link" id="admin-login-button" type="submit">Sign in</button>
        </form>
        <p class="admin-login-error" id="admin-login-error" role="alert" hidden></p>
      </section>

      <section class="admin-workspace" id="admin-workspace" hidden>
        <aside class="admin-files" data-mobile-panel="files">
          <div class="admin-panel-heading">
            <div>
              <p class="admin-eyebrow">Repository</p>
              <h1>Files</h1>
            </div>
            <div class="admin-create-toolbar">
              <button class="admin-text-button" id="admin-new" type="button">New file</button>
              <button class="admin-text-button" id="admin-new-folder" type="button">
                New folder
              </button>
            </div>
          </div>

          <label class="admin-search">
            <span class="sr-only">Search files</span>
            <input
              id="admin-file-search"
              type="search"
              autocomplete="off"
              placeholder="Find a file"
            />
          </label>

          <section class="admin-create" id="admin-create" hidden>
            <h2 id="admin-create-heading">New file</h2>
            <label>
              <span>Inside folder</span>
              <select id="admin-new-directory"></select>
            </label>
            <label>
              <span>Title</span>
              <input id="admin-new-title" type="text" autocomplete="off" />
            </label>
            <label>
              <span id="admin-new-name-label">File name</span>
              <input
                id="admin-new-path"
                type="text"
                spellcheck="false"
                aria-describedby="admin-new-target"
              />
            </label>
            <p class="admin-create-target" id="admin-new-target"></p>
            <label id="admin-new-template-field">
              <span>Template</span>
              <select id="admin-new-template">
                <option value="auto">Match this folder</option>
                <option value="blank">Standalone page</option>
              </select>
            </label>
            <label id="admin-new-author-field" hidden>
              <span>Book author</span>
              <input id="admin-new-author" type="text" autocomplete="off" />
            </label>
            <p class="admin-create-help" id="admin-new-help"></p>
            <div class="admin-create-actions">
              <button class="admin-text-button" id="admin-new-cancel" type="button">Cancel</button>
              <button class="admin-solid-button" id="admin-new-create" type="button">
                Create draft
              </button>
            </div>
          </section>

          <div class="admin-mode-notice" id="admin-link-notice" hidden>
            Choose the note that should receive the selected text.
            <button class="admin-text-button" id="admin-link-cancel" type="button">Cancel</button>
          </div>

          <nav class="admin-file-list" id="admin-file-list" aria-label="Markdown files"></nav>
          <div class="admin-tree-controls">
            <button class="admin-text-button" id="admin-expand-all" type="button">
              Expand all
            </button>
            <button class="admin-text-button" id="admin-collapse-all" type="button">
              Collapse all
            </button>
          </div>
        </aside>

        <div
          class="admin-divider"
          id="admin-files-divider"
          role="separator"
          tabindex="0"
          aria-label="Resize file panel"
          aria-orientation="vertical"
          aria-valuemin="180"
          aria-valuemax="420"
          aria-valuenow="260"
        ></div>

        <section class="admin-editor" data-mobile-panel="edit">
          <header class="admin-document-bar">
            <div class="admin-document-name">
              <p id="admin-file-path">Choose a file</p>
              <span id="admin-draft-state"></span>
            </div>
            <div class="admin-document-actions">
              <button class="admin-text-button" id="admin-create-linked" type="button" disabled>
                New note from selection
              </button>
              <button class="admin-text-button" id="admin-link-existing" type="button" disabled>
                Link existing
              </button>
              <button class="admin-solid-button" id="admin-publish" type="button" disabled>
                Publish
              </button>
            </div>
          </header>
          <div class="admin-mode-notice" id="admin-conflict-notice" hidden>
            The repository version changed. Review it before replacing it with your draft.
            <details>
              <summary>Current repository source</summary>
              <pre id="admin-conflict-source"></pre>
            </details>
            <button class="admin-text-button" id="admin-keep-draft" type="button">
              I've reviewed it. Keep my draft.
            </button>
          </div>
          <textarea
            id="admin-source"
            aria-label="Markdown source"
            autocomplete="off"
            autocapitalize="sentences"
            spellcheck="true"
            placeholder="Choose a Markdown file to begin."
            disabled
          ></textarea>
        </section>

        <div
          class="admin-divider"
          id="admin-preview-divider"
          role="separator"
          tabindex="0"
          aria-label="Resize editor and preview"
          aria-orientation="vertical"
          aria-valuemin="25"
          aria-valuemax="75"
          aria-valuenow="50"
        ></div>

        <section class="admin-preview" data-mobile-panel="preview">
          <header class="admin-preview-heading">
            <p class="admin-eyebrow" id="admin-preview-label">Draft preview</p>
            <a id="admin-public-link" href="#" target="_blank" rel="noopener" hidden
              >Open published page ↗</a
            >
          </header>
          <p class="admin-preview-notice" id="admin-preview-notice" role="status"></p>
          <iframe
            class="admin-preview-frame"
            id="admin-preview-content"
            title="Live draft preview"
            sandbox="allow-same-origin"
          ></iframe>
        </section>
      </section>
    </main>

    <nav class="admin-mobile-tabs" id="admin-mobile-tabs" aria-label="Workspace panels" hidden>
      <button type="button" data-admin-tab="files" aria-pressed="true">Files</button>
      <button type="button" data-admin-tab="edit" aria-pressed="false">Edit</button>
      <button type="button" data-admin-tab="preview" aria-pressed="false">Preview</button>
    </nav>

    <div class="admin-status" id="admin-status" role="status" aria-live="polite"></div>

    <script src="/assets/js/admin-renderer.js" defer></script>
    <script src="/assets/js/admin.js{{ '/assets/js/admin.js' | cacheBust }}" defer></script>
  </body>
</html>
