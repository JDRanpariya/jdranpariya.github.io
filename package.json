{
  "name": "personal-site",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.2.22",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.5.2",
    "baseline-browser-mapping": "^2.10.42",
    "browserslist": "^4.28.5",
    "concurrently": "^9.2.4",
    "cssnano": "^8.0.2",
    "del-cli": "^7.0.0",
    "html-minifier-terser": "^7.2.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "linkinator": "^7.6.1",
    "luxon": "^3.7.2",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-obsidian-callouts": "^0.3.4",
    "pa11y-ci": "^4.1.1",
    "postcss": "^8.5.16",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-jinja-template": "^2.2.0",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^3.4.19"
  },
  "scripts": {
    "preinstall": "node -e \"if (!/bun\\//.test(process.env.npm_config_user_agent||'')) { console.error('\\n✗ This repo uses bun, not npm/yarn/pnpm. Run: bun install\\n'); process.exit(1); }\"",
    "clean": "bunx del build",
    "start": "concurrently \"bunx @11ty/eleventy --serve\" \"bun run css:watch\"",
    "watch": "bunx @11ty/eleventy --watch",
    "build": "ELEVENTY_ENV=dev bunx @11ty/eleventy && bun run css:build",
    "build:prod": "bun run clean && bun run og:generate && bun run css:build:prod && ELEVENTY_ENV=prod bunx @11ty/eleventy",
    "setup:python": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
    "og:generate": "if [ -x .venv/bin/python ]; then .venv/bin/python scripts/generate-og-images.py; else python3 scripts/generate-og-images.py; fi",
    "debug": "DEBUG=* bunx @11ty/eleventy",
    "css:build": "bunx postcss src/css/input.css --o build/css/style.css",
    "css:build:prod": "ELEVENTY_ENV=prod bunx postcss src/css/input.css --o build/css/style.css",
    "css:watch": "bunx postcss src/css/input.css --o build/css/style.css --watch",
    "check": "bun run build:prod && bun run check:smoke && bun run check:worker && bun run check:links && bun run check:a11y && bun run check:lh",
    "check:smoke": "bun scripts/smoke.js",
    "check:worker": "node --test workers/request-intelligence/test/index.test.js",
    "check:links": "start-server-and-test 'node node_modules/http-server/bin/http-server build -p 8082 -s' 8082 'linkinator http://localhost:8082/ --recurse --retry --skip \"^(?!http://localhost:8082)\"'",
    "check:a11y": "bunx start-server-and-test 'node node_modules/http-server/bin/http-server build -p 8081 -s' 8081 'bunx pa11y-ci'",
    "check:lh": "bunx lhci autorun",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "add-notecard": "./scripts/add-notecard.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@vscode/markdown-it-katex": "^1.1.2",
    "caniuse-lite": "^1.0.30001803",
    "eleventy-plugin-toc": "^1.1.5",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1"
  }
}
