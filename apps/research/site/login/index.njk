---
layout: base.njk
permalink: /login/index.html
title: Sign in · Jay Ranpariya Research
description: Private research library sign in.
pageKind: login
noindex: true
---

<main class="page-frame flex min-h-dvh items-center py-12">
  <form id="login-form" class="mx-auto w-full max-w-sm">
    <p class="ui-label">Private research library</p>
    <h1 class="mt-3 text-3xl font-bold">Sign in</h1>
    <label class="mt-8 block font-sans text-sm" for="passphrase">Admin passphrase</label>
    <input
      id="passphrase"
      name="passphrase"
      type="password"
      autocomplete="current-password"
      required
      class="library-search mt-2 w-full appearance-none bg-transparent py-3 font-sans text-base text-ink"
    />
    <p id="login-error" class="mt-3 font-sans text-sm text-danger" role="alert" hidden></p>
    <button
      type="submit"
      class="mt-6 bg-ink px-5 py-3 font-sans text-sm text-bg disabled:opacity-50"
    >
      Continue
    </button>
  </form>
</main>
