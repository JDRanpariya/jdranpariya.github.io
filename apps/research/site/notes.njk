---
layout: public.njk
pagination:
  data: researchNotes
  size: 1
  alias: note
permalink: "{{ note.url }}index.html"
eleventyComputed:
  title: "{{ note.title }}"
  description: "{{ note.description }}"
  canonical: "https://research.jdranpariya.com{{ note.url }}"
pageKind: research
---

<div class="research-note-body">
  {% if not note.body.startsWith('# ') %}<h1>{{ note.title }}</h1>{% endif %}
  {{ note.html | safe }}
</div>
