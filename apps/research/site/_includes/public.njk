---
layout: base.njk
---

{% set isReadingPage = pageKind in researchReadingPageKinds %}

<div class="min-h-screen bg-page text-ink">
  <a href="#main" class="skip-link">Skip to content</a>
  {% include 'components/research-navigation.njk' %}
  <main
    id="main"
    tabindex="-1"
    class="{% if pageKind == 'research' or isReadingPage %}research-notes-page{% else %}research-index-page{% endif %}"
  >
    {% if isReadingPage or pageKind == 'research' %}
      {% include 'components/research-document.njk' %}
      {% if not preview %}<script id="research-note-routes" type="application/json">{{ researchNoteRoutes | safe }}</script>{% endif %}
    {% else %}
      {{ content | safe }}
    {% endif %}
  </main>
</div>
